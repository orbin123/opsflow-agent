worker_processes 1;
pid /tmp/opsflow-runtime/nginx.pid;
error_log stderr crit;
events { worker_connections 256; }
http {
    include /etc/nginx/mime.types;
    access_log off;
    server_tokens off;
    client_body_temp_path /tmp/opsflow-runtime/client;
    proxy_temp_path /tmp/opsflow-runtime/proxy;
    fastcgi_temp_path /tmp/opsflow-runtime/fastcgi;
    uwsgi_temp_path /tmp/opsflow-runtime/uwsgi;
    scgi_temp_path /tmp/opsflow-runtime/scgi;
    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }
    server {
        listen __PORT__;
        auth_basic "OpsFlow temporary demo";
        auth_basic_user_file /tmp/opsflow-runtime/htpasswd;
        location = /health {
            auth_basic off;
            proxy_pass http://127.0.0.1:8501/_stcore/health;
        }
        location /api/ { return 404; }
        location = /metrics { return 404; }
        location = /docs { return 404; }
        location = /openapi.json { return 404; }
        location / {
            proxy_pass http://127.0.0.1:8501;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Authorization "";
            proxy_read_timeout 240s;
            proxy_buffering off;
        }
    }
}
